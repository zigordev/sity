{
  "name": "sity",
  "version": "0.1.0",
  "private": true,
  "description": "Three.js coastal city and lane graph for smart-traffic simulation",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "node ./scripts/prepare-husky.mjs",
    "dev": "npm run dev -w @sity/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "e2e": "npm run e2e -w @sity/web",
    "format": "prettier --write \".github/**/*.{yml,yaml}\" \"docker/**/*.{yml,yaml}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \"README.md\" \"package.json\" \".release-please-config.json\" \".release-please-manifest.json\"",
    "format:check": "prettier --check \".github/**/*.{yml,yaml}\" \"docker/**/*.{yml,yaml}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \"README.md\" \"package.json\" \".release-please-config.json\" \".release-please-manifest.json\"",
    "test:secrets:gitleaks": "./scripts/precommit-gitleaks.sh",
    "ci:quality:local": "npm run format:check && npm run lint && npm run typecheck && npm run test:cov && npm run build",
    "precommit:checks": "npm run test:secrets:gitleaks && npm run ci:quality:local",
    "local:up": "bash ./scripts/local-stack-up.sh",
    "local:down": "bash ./scripts/local-stack-down.sh",
    "audit": "npm audit --audit-level=high",
    "audit:prod:gate": "node ./scripts/audit-prod-gate.mjs",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules"
  },
  "overrides": {
    "postcss": "8.5.27"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.1.0",
    "typescript": "^5.8.3"
  }
}
