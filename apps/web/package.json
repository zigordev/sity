{
  "name": "@sity/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && vite build --config vite.server.config.ts",
    "start": "node dist-server/main.js",
    "lint": "eslint --no-cache .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify:render": "playwright test",
    "generate:assets": "node scripts/generate-asset-pack.mjs",
    "clean": "rm -rf dist dist-server coverage playwright-report test-results"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/static": "^10.1.4",
    "@opentelemetry/api": "^1.9.1",
    "fastify": "^5.12.5",
    "prom-client": "^15.1.3",
    "source-map-js": "^1.2.1",
    "three": "^0.186.0",
    "web-vitals": "^6.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
