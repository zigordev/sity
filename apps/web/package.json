{
  "name": "@sity/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint --no-cache .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify:render": "playwright test",
    "generate:assets": "node scripts/generate-asset-pack.mjs",
    "clean": "rm -rf dist coverage playwright-report test-results"
  },
  "dependencies": {
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.61.1",
    "@types/three": "^0.178.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
